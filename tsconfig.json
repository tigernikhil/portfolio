{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@platform/contracts": [
        "packages/contracts/src"
      ],
      "@platform/tool-sdk": [
        "packages/tool-sdk/src"
      ],
      "@platform/tool-registry": [
        "packages/tool-registry/src"
      ],
      "@platform/tool-runtime": [
        "packages/tool-runtime/src"
      ]
    }
  },
  "include": [
    "packages/**/*",
    "tools/**/*",
    "apps/**/*"
  ]
}
